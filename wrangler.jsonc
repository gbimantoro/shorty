{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shorty",
  "main": "src/index.ts",
  "account_id": "e622e48acf468b7f3a311b3a9460a35f",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "SHORTY_KV",
      "id": "cbf4647d82ec4164b71b46850a7e336c",
      "preview_id": "470cfc66b073477aa604cd1a05798b23"
    }
  ],
  "routes": [
    {
      "pattern": "s.joyof.care",
      "custom_domain": true
    }
  ],
  "vars": {
    "APP_NAME": "Shorty",
    "DEFAULT_REDIRECT_CODE": "302",
    "RATE_LIMIT_PER_MINUTE": "60"
  },
  "observability": {
    "enabled": true
  }
}
