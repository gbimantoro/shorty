{
  "name": "shorty",
  "version": "1.0.0",
  "description": "Blazingly fast, super secure and tiny URL shortener on Cloudflare Workers",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "kv:create": "wrangler kv namespace create SHORTY_KV",
    "kv:create:preview": "wrangler kv namespace create SHORTY_KV --preview"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "url-shortener",
    "serverless",
    "edge",
    "kv"
  ],
  "author": "GBimantoro <bimo@gbimantoro.com>",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "wrangler": "^4.160.1"
  }
}
